# 所有文件统一使用 LF 换行，Git 仓库内始终为 LF
* text=auto

# HTML/CSS/JS 等文本文件：检出时转成 LF（Mac/Unix 风格）
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# 图片/二进制文件不做转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
