# 所有文本文件入库统一为 LF：仓库内永远 LF，三平台（macOS/Windows/Linux）一致
* text=auto

# Web/文本文件：任何系统检出都保持 LF（现代编辑器均兼容 LF，避免混合行尾）
*.html text eol=lf
*.htm  text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.xml  text eol=lf
*.svg  text eol=lf
*.py   text eol=lf
*.sh   text eol=lf
*.toml text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf

# Windows 专属脚本：强制 CRLF（批处理文件要求 CRLF，LF 会导致解析异常）
*.bat  text eol=crlf
*.cmd  text eol=crlf

# 二进制文件：禁止任何行尾/编码转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.pdf   binary
*.zip   binary
